# Local values and credentials; sanitized examples stay in source control.
*.tfvars
*.tfvars.*
!*.tfvars.example
!*.tfvars.json.example
*.tfbackend
*.tfbackend.*
!*.tfbackend.example
.env
.env.*
!.env.example
.azure/
.secrets/
*.key
*.pem
*.pfx
*.p12

# Terraform caches, local state, and saved plans can contain credentials.
.terraform/
.terraform.d/
.terraformrc
terraform.rc
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan
tfplan.*
*.plan
*.plan.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep .terraform.lock.hcl and sanitized configuration examples tracked.

# Local Python environments and notebook validation caches.
.venv/
__pycache__/
*.py[cod]

# Disposable verification checkouts and generated runtime artifacts.
.artifacts/

# DemoIQ keeps its configs (with demo-user passwords), runs and seeded content in
# ~/.copilot/DemoIQ-Output-Scout; never commit stray copies of them, or of files an upstream
# DemoIQ-Scout install may leave in the skill folder.
DemoIQ_config*.json
!.github/skills/demoiq-seed/scripts/presets/DemoIQ_config.template.json
DemoIQ-Output/
DemoIQ-Deliverables/
.github/skills/demoiq-seed/**/app_registration.json
.github/skills/demoiq-seed/**/speech_resource.json

# App dependencies, builds and the Managed Runtime CLI's local cache.
node_modules/
dist/
*.tsbuildinfo
.ms/

# Local logs, notes, editor backups, and OS metadata.
*.log
scratch.md
*.swp
*.swo
*~
.DS_Store
Thumbs.db
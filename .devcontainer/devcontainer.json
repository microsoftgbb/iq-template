{
  "name": "Fabric and Foundry development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "gatewayPorts": "no"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.5",
      "tflint": "none",
      "terragrunt": "none"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "nodeGypDependencies": true,
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "7.6"
    },
    "./features/managed-runtime": {},
    "./features/iq-plugins": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "dotnet tool restore && bash .devcontainer/check-tools.sh",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Managed Runtime app",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Managed Runtime config",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

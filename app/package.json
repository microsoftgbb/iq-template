{
  "name": "scenario-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.ts",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env.local dist-server/main.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.47",
    "@azure/msal-browser": "^5.28.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}

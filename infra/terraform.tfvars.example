project_name           = "<project-name>"
location               = "<azure-region>"
fabric_capacity_admins = ["<your-user-principal-name>"]
github_owner           = "<github-organization-or-user>"
github_repository_name = "<new-repository-name>"
github_branch_name     = "<published-bootstrap-branch>"

knowledge_lakehouse_id = null
knowledge_ontologies   = {}

# Edit all six values for your derived repository, or use the initialize-project skill.
# project_name: 3-16 lowercase letters/digits/single hyphens; start with a letter.
# Capacity admins: user UPNs or service-principal object IDs.
# Select the new repository's published default branch, not a local agent worktree branch.
# Defaults: F2 capacity, Basic Search; Git bootstrap uses /workspace.
# Check Fabric CU quota and Search new-service capacity before applying.
# location is the common region and always remains the Foundry/resource-group region.
# Only after explicitly approving cross-region costs/data handling, optionally set:
# fabric_location = "<approved-fabric-region>"
# search_location = "<approved-search-region>"
# These default to location. Never change a deployed region as an automatic retry.
# Use one state: first target module.fabric_user_auth to prepare the Entra application.
# An administrator grants consent; sign in with the generated scope before a full plan.
# The first full apply creates the platform, not the Git connection or workspace items.
# After Git sync with Bootstrap and successful seed/binding runs, replace null with the
# DEV Scenario lakehouse's physical GUID (not its .platform logicalId) and apply again.
# Register the bound ontology in that same knowledge apply:
# knowledge_ontologies = {
#   scenario = {
#     ontology_id = "<dev-ScenarioOntology-physical-guid>"
#     description = "Current sites, assets, their status, and which site each asset belongs to."
#   }
# }
# Ontology queries require delegated user authentication at runtime, not a saved token.
# Registered ontologies also receive native Foundry Fabric IQ UserEntraToken connections.
# fabric_iq_connections outputs their IDs/endpoints; this does not create a consuming
# agent/app or prove its OBO flow. Search fabricOntology calls still need the user header.
# Guided Codespaces deployment reads the FABRIC_GITHUB_TOKEN Codespaces secret.
# Set TF_VAR_github_token in your shell; never add a PAT to this file.

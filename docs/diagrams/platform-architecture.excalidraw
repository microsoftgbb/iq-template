      "link": null,
      "locked": true,
      "customData": {
        "title": "Fabric + Foundry IQ",
        "description": "Intended derived-project architecture, not deployment evidence. GitHub and Copilot author the project; Terraform owns infrastructure. Fabric DEV holds a Scenario lakehouse and bound Site/Asset ontology, while TEST begins empty. OneLake files are indexed into Azure AI Search. The Copilot Studio agent uses Foundry IQ for documents and native Fabric IQ for live facts, with each user's own connections. A Managed Runtime app calls only that agent. Foundry supplies the project and models. Deployment and runtime authorization are separate.",
        "role": "page"
      },
      "index": "a0"
    },
